# Neon PostgreSQL connection string (used in production / Vercel)
DATABASE_URL=postgresql://user:password@ep-xxxx-region.neon.tech/hrd_system?sslmode=require

# Optional fallback for local development (only used when DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=replace-with-local-database-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrd_system

PORT=5000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=1d
GEMINI_API_KEY=replace-with-gemini-api-key
